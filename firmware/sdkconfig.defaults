# ESP-IDF settings for the head tracker. Arduino's prebuilt core ships with
# power management off, so we build Arduino as an ESP-IDF component instead.

# Required by the Arduino component
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Flash layout: two app slots for BLE updates (see partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Boot a new image "on probation" and go back if it isn't confirmed
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bluetooth controller only; NimBLE-Arduino brings its own host stack
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n

# Power: frequency scaling + automatic light sleep when all tasks are idle
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
# Let the BLE radio sleep between connection events. The Super Mini has no
# 32 kHz crystal, so the main crystal keeps BLE timing during sleep.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
# Without this, the BT controller sees "main crystal as sleep clock" and takes
# a no-light-sleep lock for as long as Bluetooth is on, so the chip never sleeps.
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_ESP32C3_DEFAULT_CPU_FREQ_160=y
